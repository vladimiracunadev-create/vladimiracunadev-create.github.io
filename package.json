{
    "name": "portfolio-static",
    "version": "2.5.0",
    "description": "Static portfolio with CI/CD",
    "scripts": {
        "test": "node scripts/validate.js",
        "validate": "node scripts/validate.js",
        "lint:html": "html-validate \"index.html\" \"offline.html\" \"i18n/**/*.html\" \"experiencia-3d/**/*.html\" \"servicios/**/*.html\"",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!.gradle-user-home/**\" \"!.gradle-user-home-*/**\" \"!dist/**\" \"!site/**\" \"!sources/profile-readme/**\" \"!docs/i18n/**\"",
        "lint": "pnpm lint:html && pnpm lint:md",
        "sitemap": "node scripts/generate-seo.js",
        "build": "node scripts/build.js",
        "lhci": "lhci collect && lhci assert || echo Aviso: Saltando error de limpieza en Windows"
    },
    "devDependencies": {
        "html-validate": "^8.0.0",
        "markdownlint-cli2": "^0.12.0",
        "terser": "^5.27.0",
        "clean-css-cli": "^5.6.3",
        "fs-extra": "^11.2.0",
        "@lhci/cli": "^0.13.0"
    },
    "private": true,
    "packageManager": "pnpm@11.0.0",
    "pnpm": {
        "onlyBuiltDependencies": []
    }
}
