:root {
  --bg: #0b0d10;
  --text: #e8eefc;
  --muted: #a7b0c3;
  --line: rgba(255, 255, 255, .12);
  --line-strong: rgba(255, 255, 255, .22);
  --shadow: 0 10px 24px rgba(0, 0, 0, .35);
  --card-bg: linear-gradient(180deg, rgba(255, 255, 255, .04), rgba(255, 255, 255, .02));
  --card-soft: linear-gradient(180deg, rgba(255, 255, 255, .03), rgba(255, 255, 255, .01));
  --btn-bg: rgba(255, 255, 255, .04);
  --accent: #70a5ff;
  --accent-soft: rgba(112, 165, 255, .16);
  --accent-strong: rgba(112, 165, 255, .34);
  --surface: rgba(255, 255, 255, .03);
  --radius2: 22px;
  --max: 1120px;
  --pad: 20px;
}

body[data-theme="light"] {
  --bg: #f8fafc;
  --text: #0f172a;
  --muted: #64748b;
  --line: rgba(0, 0, 0, .08);
  --line-strong: rgba(0, 0, 0, .14);
  --shadow: 0 10px 24px rgba(0, 0, 0, .08);
  --card-bg: #ffffff;
  --card-soft: #f1f5f9;
  --btn-bg: rgba(0, 0, 0, .05);
  --accent: #2563eb;
  --accent-soft: rgba(37, 99, 235, .10);
  --accent-strong: rgba(37, 99, 235, .2);
  --surface: rgba(255, 255, 255, .7);
}

/* --- LÓGICA DE VISIBILIDAD MULTILINGÜE --- */
/* Ocultar por defecto para evitar parpadeos */
[data-en],
[data-es],
[data-pt],
[data-it],
[data-fr],
[data-zh] {
  display: none !important;
}

/* Visibilidad basada en el idioma activo (spans y elementos inline) */
body:not([data-lang]) [data-es],
body[data-lang="es"] [data-es] { display: revert !important; }

body[data-lang="en"] [data-en] { display: revert !important; }
body[data-lang="pt"] [data-pt] { display: revert !important; }
body[data-lang="it"] [data-it] { display: revert !important; }
body[data-lang="fr"] [data-fr] { display: revert !important; }
body[data-lang="zh"] [data-zh] { display: revert !important; }

/* Elementos de bloque: forzar display:block donde revert no alcanza */
body:not([data-lang]) div[data-es],  body[data-lang="es"] div[data-es],
body:not([data-lang]) section[data-es], body[data-lang="es"] section[data-es],
body:not([data-lang]) article[data-es], body[data-lang="es"] article[data-es],
body:not([data-lang]) p[data-es],    body[data-lang="es"] p[data-es],
body:not([data-lang]) h1[data-es],   body[data-lang="es"] h1[data-es],
body:not([data-lang]) h2[data-es],   body[data-lang="es"] h2[data-es],
body:not([data-lang]) h3[data-es],   body[data-lang="es"] h3[data-es] {
  display: block !important;
}

body[data-lang="en"] div[data-en],   body[data-lang="en"] section[data-en],
body[data-lang="en"] article[data-en], body[data-lang="en"] p[data-en],
body[data-lang="en"] h1[data-en],    body[data-lang="en"] h2[data-en],
body[data-lang="en"] h3[data-en] { display: block !important; }

body[data-lang="pt"] div[data-pt],   body[data-lang="pt"] section[data-pt],
body[data-lang="pt"] article[data-pt], body[data-lang="pt"] p[data-pt],
body[data-lang="pt"] h1[data-pt],    body[data-lang="pt"] h2[data-pt],
body[data-lang="pt"] h3[data-pt] { display: block !important; }

body[data-lang="it"] div[data-it],   body[data-lang="it"] section[data-it],
body[data-lang="it"] article[data-it], body[data-lang="it"] p[data-it],
body[data-lang="it"] h1[data-it],    body[data-lang="it"] h2[data-it],
body[data-lang="it"] h3[data-it] { display: block !important; }

body[data-lang="fr"] div[data-fr],   body[data-lang="fr"] section[data-fr],
body[data-lang="fr"] article[data-fr], body[data-lang="fr"] p[data-fr],
body[data-lang="fr"] h1[data-fr],    body[data-lang="fr"] h2[data-fr],
body[data-lang="fr"] h3[data-fr] { display: block !important; }

body[data-lang="zh"] div[data-zh],   body[data-lang="zh"] section[data-zh],
body[data-lang="zh"] article[data-zh], body[data-lang="zh"] p[data-zh],
body[data-lang="zh"] h1[data-zh],    body[data-lang="zh"] h2[data-zh],
body[data-lang="zh"] h3[data-zh] { display: block !important; }

* {
  box-sizing: border-box
}

html,
body {
  height: 100%
}

body {
  margin: 0;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
  background: radial-gradient(1200px 800px at 20% -10%, rgba(90, 140, 255, .12), transparent 55%),
    radial-gradient(1000px 700px at 90% 10%, rgba(0, 240, 255, .08), transparent 50%),
    radial-gradient(900px 600px at 50% 30%, rgba(112, 165, 255, .05), transparent 60%),
    var(--bg);
  color: var(--text);
  line-height: 1.5;
  transition: background 0.3s, color 0.3s;
}

a {
  color: inherit
}

code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace
}

pre {
  overflow: auto
}

.wrap {
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 var(--pad)
}

.mt-6 {
  margin-top: 6px
}

.mt-0 {
  margin-top: 0
}

.text-center-pad {
  text-align: center;
  padding: 8px 0
}

.mt-10 {
  margin-top: 10px
}

.skip {
  position: absolute;
  left: -999px;
  width: 1px;
  height: 1px;
  overflow: hidden
}

.skip:focus {
  left: 12px;
  top: 12px;
  width: auto;
  height: auto;
  padding: 8px 10px;
  background: #000;
  border: 1px solid var(--line);
  border-radius: 10px;
  z-index: 999
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in srgb, var(--bg) 78%, transparent);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
  box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
}

.topbar__inner {
  display: grid;
  grid-template-areas:
    "brand side"
    "nav nav";
  grid-template-columns: minmax(220px, auto) 1fr;
  align-items: center;
  padding: 10px var(--pad) 12px;
  gap: 8px 18px;
}

.topbar__main {
  display: contents;
}

.topbar__side {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14px;
  grid-area: side;
  min-width: 0;
  flex-wrap: wrap;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  grid-area: brand;
  flex-shrink: 0;
  min-width: 220px;
}

.brand__name {
  font-weight: 750;
  letter-spacing: .2px;
  font-size: 15px
}

.brand__role {
  font-size: 12px;
  color: var(--muted)
}

.iconbtn {
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, .04);
  color: var(--text);
  border-radius: 12px;
  padding: 12px;
  cursor: pointer;
  display: none;
  min-width: 44px;
  min-height: 44px;
}

.nav {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  grid-area: nav;
  width: 100%;
}

.nav a {
  text-decoration: none;
  color: var(--muted);
  font-size: 13px;
  padding: 8px 11px;
  border-radius: 12px;
  display: inline-block;
  font-weight: 500;
  opacity: .7;
  transition: opacity .2s;
  white-space: nowrap;
}

.nav a:hover {
  color: var(--text);
  background: var(--surface);
  opacity: 1
}

.views {
  display: flex;
  align-items: center;
  gap: 10px;
  /* Sin wrap, los 3 chips de vista desbordaban ~22px en pantallas de 375px
     y aparecia scroll horizontal en toda la pagina. */
  flex-wrap: wrap;
  flex-shrink: 0;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  backdrop-filter: blur(10px);
}

.views__label {
  font-size: 12px;
  color: var(--muted)
}

.views__group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px
}

.chip {
  border: 1px solid var(--line);
  background: var(--btn-bg);
  color: var(--muted);
  padding: 10px 14px;
  border-radius: 999px;
  cursor: pointer;
  font-size: 13px;
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  transition: transform .18s ease, background .18s ease, border-color .18s ease, color .18s ease;
}

.chip:hover {
  transform: translateY(-1px);
  border-color: var(--line-strong);
  color: var(--text);
}

.chip.is-active {
  color: var(--text);
  background: linear-gradient(180deg, var(--accent-strong), var(--accent-soft));
  border-color: color-mix(in srgb, var(--accent) 45%, var(--line))
}

.settings {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-shrink: 0;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  backdrop-filter: blur(10px);
}

.lang-select {
  background: var(--btn-bg);
  color: var(--text);
  border: 1px solid var(--line);
  padding: 6px 12px;
  border-radius: 10px;
  font-size: 13px;
  cursor: pointer;
  outline: none;
  backdrop-filter: blur(5px);
  appearance: none;
  /* Eliminar flecha nativa para un look más limpio */
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 8px center;
  background-size: 12px;
  padding-right: 28px;
  color-scheme: dark;
  min-height: 40px;
  /* Ayuda a que los estilos nativos de las options hereden el tema oscuro */
}

.lang-select option {
  background-color: #1a1d23;
  /* Fondo oscuro específico para las opciones */
  color: var(--text);
}

body[data-theme="light"] .lang-select {
  stroke: black;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  color-scheme: light;
}

body[data-theme="light"] .lang-select option {
  background-color: #ffffff;
  color: #0f172a;
}

.theme-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--btn-bg);
  border: 1px solid var(--line);
  color: var(--text);
  padding: 6px 14px;
  border-radius: 10px;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s;
  backdrop-filter: blur(5px);
  min-height: 40px;
}

.theme-toggle:hover {
  background: var(--surface);
  border-color: var(--line-strong);
}

.theme-toggle i {
  font-style: normal;
}

.hero {
  padding: 50px 0 30px
}

.hero__inner {
  display: grid;
  grid-template-columns: 1.3fr .9fr;
  gap: 20px;
  align-items: start
}

.hero h1 {
  margin: 0 0 10px;
  font-size: clamp(34px, 5vw, 52px);
  line-height: 1.1
}

.lead {
  margin: 0 0 16px;
  color: var(--muted);
  font-size: 17px;
  max-width: 68ch
}

.hero__context {
  margin: 0 0 16px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: linear-gradient(180deg, var(--surface), transparent);
  color: var(--muted);
  font-size: 13px;
  max-width: 72ch;
}

.hero__context strong {
  color: var(--text)
}

.meta {
  margin-top: 12px;
  color: var(--muted);
  font-size: 12px
}

.hero__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 16px 0
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: linear-gradient(180deg, var(--surface), transparent);
  font-size: 12px;
  color: var(--muted);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05);
}

/* Badge de origen (GH/GL) del widget #recentRepos. La clase se usaba en el
   markup desde el principio pero nunca tuvo regla: el tamano venia de un
   style= inline que la CSP del sitio bloquea. Selector compuesto a
   proposito, para no alcanzar el `.mini` suelto de index.html. */
.pill.mini {
  padding: .1rem .35rem;
  font-size: .65rem;
  vertical-align: middle;
}

.cta {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin: 14px 0
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: var(--btn-bg);
  text-decoration: none;
  color: var(--text);
  font-weight: 650;
  font-size: 14px;
  cursor: pointer;
  min-height: 44px;
  transition: transform .18s ease, background .18s ease, border-color .18s ease, box-shadow .18s ease;
}

.btn:hover {
  background: rgba(255, 255, 255, .08);
  transform: translateY(-1px);
  border-color: var(--line-strong);
  box-shadow: 0 10px 24px rgba(0, 0, 0, .12)
}

.btn.primary {
  background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 45%, transparent), color-mix(in srgb, var(--accent) 18%, transparent));
  border-color: color-mix(in srgb, var(--accent) 55%, var(--line))
}

.social {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 10px
}

.link {
  color: var(--muted);
  text-decoration: none;
  font-size: 14px;
  padding: 8px;
  display: inline-block;
}

.link:hover {
  color: var(--text);
  text-decoration: underline
}

.section {
  padding: 34px 0
}

.section--compact {
  padding: 8px 0 18px
}

.section__head {
  margin-bottom: 14px
}

.section__head h2 {
  margin: 0 0 6px;
  font-size: 26px
}

.muted {
  color: var(--muted)
}

.small {
  font-size: 13px
}

.big {
  font-size: 18px
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px
}

.grid--2 {
  grid-template-columns: 1fr 1fr
}

.grid--3 {
  grid-template-columns: 1fr 1fr 1fr
}

.card {
  background: var(--card-bg);
  border: 1px solid var(--line);
  border-radius: var(--radius2);
  box-shadow: var(--shadow);
  padding: 16px;
  position: relative;
  overflow: hidden;
  transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}

/* ─────────────────────────────────────────────────────────────────
   Jerarquía visual: HERO vs SECONDARY (proyectos)
   - Cards sin data-min-level (hero) → tamaño original, acento sutil izq.
   - Cards data-min-level="1" o "2" → compactas (menor padding, fuente
     más pequeña, pills más pequeñas). La mirada va primero a las hero.
   ───────────────────────────────────────────────────────────────── */
.card.project:not([data-min-level]) {
  border-left: 3px solid var(--accent, #4ECDC4);
}

.card.project[data-min-level="1"],
.card.project[data-min-level="2"] {
  padding: 12px 14px;
}

.card.project[data-min-level="1"] h3,
.card.project[data-min-level="2"] h3 {
  font-size: 0.95em;
}

.card.project[data-min-level="1"] p,
.card.project[data-min-level="2"] p {
  font-size: 0.88em;
  line-height: 1.45;
}

.card.project[data-min-level="1"] .pill,
.card.project[data-min-level="2"] .pill {
  font-size: 11px;
  padding: 5px 8px;
}

.card.project[data-min-level="1"] .chips,
.card.project[data-min-level="2"] .chips {
  gap: 6px;
  margin: 10px 0;
}

.card.project[data-min-level="1"] .actions .btn,
.card.project[data-min-level="2"] .actions .btn {
  padding: 6px 12px;
  font-size: 12px;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent-strong), transparent);
}

.card.soft {
  background: var(--card-soft)
}

.card:hover {
  transform: translateY(-2px);
  border-color: var(--line-strong);
  box-shadow: 0 16px 36px rgba(0, 0, 0, .16);
}

.card h2 {
  margin: 0 0 10px;
  font-size: 18px
}

.card h3 {
  margin: 0 0 10px;
  font-size: 17px
}

.card p {
  margin: 0 0 10px
}

.card p:last-child {
  margin-bottom: 0
}

.hero__cards {
  display: flex;
  flex-direction: column;
  gap: 14px
}

.profile-brief {
  background: linear-gradient(180deg, var(--accent-soft), transparent 68%), var(--card-bg);
}

.recruiter-quick {
  background: linear-gradient(180deg, var(--surface), transparent 65%), var(--card-bg);
}

.quick-list {
  margin: 0;
  padding-left: 18px;
}

.quick-list li {
  margin: 7px 0;
  color: var(--muted);
}

.signal-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.signal {
  padding: 16px 14px;
  min-height: 150px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.signal__value {
  font-size: clamp(26px, 4vw, 38px);
  font-weight: 800;
  line-height: 1;
  margin-bottom: 8px;
  color: var(--text);
}

.signal p {
  margin: 0;
}

.bullets {
  margin: 10px 0 0;
  padding-left: 18px
}

.bullets li {
  margin: 6px 0;
  color: var(--muted)
}

.bullets li strong {
  color: var(--text)
}

.project__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 6px
}

.tag {
  font-size: 11px;
  color: var(--muted);
  border: 1px solid var(--line);
  padding: 6px 10px;
  border-radius: 999px;
  background: linear-gradient(180deg, var(--surface), transparent)
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 10px 0
}

/* Fila de estadisticas de #recentRepos: separa los pills de la lista de
   actividad que va justo debajo. Sustituye un style= inline bloqueado. */
.chips--stats {
  margin: 10px 0 .75rem
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px
}

.code {
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 12px;
  background: rgba(0, 0, 0, .25);
  color: #dbe6ff;
  font-size: 12.5px;
  line-height: 1.45;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 14px
}

.titem {
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px dashed rgba(255, 255, 255, .14)
}

.titem:last-child {
  border-bottom: none
}

.twhen {
  color: var(--muted);
  font-weight: 700
}

.downloads {
  display: flex;
  gap: 10px;
  flex-wrap: wrap
}

.collab-criteria,
.collab-cta {
  margin-top: 16px
}

.collab-criteria .chips {
  margin-top: 12px
}

.collab-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: linear-gradient(180deg, var(--accent-soft), transparent 70%), var(--card-bg);
}

.collab-cta>div:first-child {
  max-width: 780px
}

.collab-cta .actions {
  flex-shrink: 0;
  margin-top: 0
}

.app-download {
  display: flex;
  flex-direction: column;
  gap: 16px;
  justify-content: center;
  background: linear-gradient(180deg, var(--accent-soft), transparent 55%), var(--card-bg);
}

.app-download__brand {
  display: flex;
  align-items: center;
  gap: 16px
}

.app-icon {
  border-radius: 14px;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .3);
  background: #1e293b;
  padding: 4px
}

.skeleton-btn {
  height: 44px;
  width: 140px;
  background: rgba(255, 255, 255, .05);
  border-radius: 14px;
  animation: pulse 1.5s infinite
}

@keyframes pulse {
  0% {
    opacity: .5
  }

  50% {
    opacity: .3
  }

  100% {
    opacity: .5
  }
}

.repos {
  display: grid;
  gap: 10px;
  margin-top: 10px
}

.repo {
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: linear-gradient(180deg, var(--surface), transparent)
}

.repo__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px
}

.repo__name {
  font-weight: 750;
  text-decoration: none
}

.repo__meta {
  color: var(--muted);
  font-size: 12px
}

.repo__desc {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 13px
}

.contact__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap
}

.card.highlight-feb {
  background: linear-gradient(180deg, var(--accent-soft), rgba(90, 140, 255, .05));
  border-color: color-mix(in srgb, var(--accent) 30%, var(--line))
}

.contact__actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap
}

.is-hidden {
  display: none !important
}

[data-hidden="true"] {
  display: none !important
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

body[data-view="deep"] .card.soft,
body[data-view="deep"] .repo {
  border-color: color-mix(in srgb, var(--accent) 24%, var(--line));
}

@media (max-width:980px) {
  .hero__inner {
    grid-template-columns: 1fr
  }

  .views {
    min-width: auto
  }

  .settings,
  .views {
    justify-content: center;
  }

  .grid,
  .grid--2,
  .grid--3,
  .signal-grid {
    grid-template-columns: 1fr
  }

  .titem {
    grid-template-columns: 1fr
  }

  .collab-cta {
    align-items: flex-start;
    flex-direction: column
  }

  .collab-cta .actions {
    width: 100%
  }

  .brand {
    min-width: auto
  }
}

@media (max-width:820px) {
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px var(--pad);
    min-height: 70px;
    gap: 14px;
    flex-wrap: wrap;
    position: relative;
  }

  .topbar__main {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .topbar__side {
    width: 100%;
    justify-content: center;
    gap: 12px;
  }

  /* En movil la barra de vistas media 420px dentro de un padre de 335px y,
     con flex-shrink: 0, se negaba a encoger: desbordaba ~22px y ponia scroll
     horizontal en toda la pagina. Aqui se le permite encoger y envolver. */
  .views {
    flex-shrink: 1;
    max-width: 100%;
  }

  .iconbtn {
    display: inline-flex
  }

  .nav {
    display: none;
    position: absolute;
    left: 12px;
    right: 12px;
    top: 62px;
    flex-direction: column;
    background: rgba(10, 12, 15, .95);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 12px;
  }

  .nav.is-open {
    display: flex
  }
}

/* ══════════════════════════════════════════════════════════════════
   GRUPOS PLEGABLES DE PROYECTOS
   #proyectos crecia sin jerarquia: 35 cards de igual peso en una
   rejilla plana. Se agrupan por la taxonomia del perfil y cada grupo
   muestra 4 cards; el resto se despliega bajo demanda.
   ══════════════════════════════════════════════════════════════════ */

/* Contenedor de los grupos: apila en bloque. Si fuera .grid, cada grupo
   ocuparia una celda de 2 columnas y las cards de dentro se partirian
   a la mitad del ancho. */
.project-groups {
  display: block
}

.project-group {
  margin-top: 26px
}

.project-group__head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--line)
}

.project-group__title {
  margin: 0;
  font-size: 1.02rem;
  letter-spacing: .2px
}

.project-group__count {
  font-size: .78rem;
  padding: 2px 9px;
  border-radius: 999px;
  border: 1px solid var(--line);
  color: var(--muted);
  background: var(--btn-bg)
}

.project-group__toggle {
  margin-top: 12px;
  width: 100%;
  font-size: .88rem
}

.project-group__toggle .js-count {
  font-variant-numeric: tabular-nums;
  font-weight: 600
}

/* Alterna la etiqueta del boton segun su estado, sin tocar el i18n:
   los envoltorios no llevan data-<idioma>, asi que el idioma activo
   se sigue resolviendo dentro de cada uno. */
.project-group__toggle .lbl-less {
  display: none
}

.project-group__toggle[aria-expanded="true"] .lbl-more {
  display: none
}

.project-group__toggle[aria-expanded="true"] .lbl-less {
  display: inline
}

/* Canal propio de ocultamiento: setView() reescribe data-hidden en todo
   [data-min-level], asi que el plegado no puede compartir ese atributo. */
article.card.project[data-collapsed="true"] {
  display: none !important
}

/* ── Descripciones recortadas a 2 lineas ──────────────────────────
   Se recorta por CSS y no partiendo el texto en el HTML: asi la
   descripcion completa sigue en el DOM para crawlers, llm.txt y la
   API JSON. La card se expande al pulsar el texto.                */

article.card.project > p {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden
}

article.card.project.is-open > p {
  display: block;
  -webkit-line-clamp: unset;
  line-clamp: unset;
  overflow: visible
}

article.card.project > p[role="button"] {
  cursor: pointer
}

article.card.project > p[role="button"]:focus-visible {
  outline: 2px solid var(--accent, #3b82f6);
  outline-offset: 3px;
  border-radius: 6px
}

/* ══════════════════════════════════════════════════════════════════
   SHELL DE DOS COLUMNAS  (sidebar sticky + contenido centrado)
   Antes: topbar horizontal sticky + una sola columna. El nav, las
   vistas y los ajustes competian por el ancho de la barra y en 820px
   se apilaban en tres filas que comian 190px de alto util.
   Ahora: panel lateral fijo de 19rem en escritorio (nav vertical, sin
   wrap) y drawer off-canvas en movil; el contenido conserva su
   max-width de var(--max) dentro de la columna derecha.
   ══════════════════════════════════════════════════════════════════ */

:root {
  --sidebar-w: 19rem;
  --shell-gap: 28px;
  --radius-shell: 26px;
}

.shell {
  display: block;
}

.shell__main {
  min-width: 0;
}

/* ── Sidebar ────────────────────────────────────────────────────── */

.sidebar {
  z-index: 60;
  /* Los porcentajes deben sumar 100: con 86+5 el color-mix quedaba al 91%
     de opacidad y en movil el hero se transparentaba tras el drawer. */
  background: color-mix(in srgb, var(--bg) 94%, var(--text) 6%);
  border-right: 1px solid var(--line);
}

.sidebar__inner {
  display: flex;
  flex-direction: column;
  gap: 18px;
  height: 100%;
  padding: 22px 16px 18px;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.sidebar__id {
  display: grid;
  justify-items: center;
  gap: 4px;
  padding: 6px 4px 2px;
  text-align: center;
  text-decoration: none;
  color: inherit;
}

.sidebar__avatar {
  display: block;
  width: 104px;
  height: 104px;
  margin-bottom: 10px;
  border-radius: 50%;
  border: 1px solid var(--line);
  /* La foto es 320x320; object-fit evita que el 1:1 se deforme si algun dia
     se sustituye por una imagen de otra proporcion. El degradado queda de
     placeholder mientras carga. */
  object-fit: cover;
  background: linear-gradient(145deg, var(--accent-soft), transparent 72%), var(--card-bg);
  /* Doble anillo con hueco, como el avatar de referencia: el primer
     halo pinta el fondo para separar el aro de acento del borde. */
  box-shadow: 0 0 0 4px var(--bg), 0 0 0 6px var(--accent-strong);
  transition: box-shadow .25s ease;
}

.sidebar__id:hover .sidebar__avatar {
  box-shadow: 0 0 0 4px var(--bg), 0 0 0 6px var(--accent);
}

.sidebar__id .brand__name {
  font-size: 15px;
}

.sidebar__id .brand__role {
  font-size: 12px;
  line-height: 1.35;
  max-width: 15rem;
}

/* ── Navegacion vertical ────────────────────────────────────────── */

.sidenav {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sidenav a {
  display: block;
  padding: 10px 12px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: var(--muted);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  transition: background .18s ease, color .18s ease, border-color .18s ease;
}

.sidenav a:hover,
.sidenav a:focus-visible {
  background: var(--surface);
  border-color: var(--line);
  color: var(--text);
}

/* ── Controles al pie del sidebar ───────────────────────────────── */

.sidebar__controls {
  display: grid;
  gap: 10px;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.sidebar .views,
.sidebar .settings {
  display: grid;
  gap: 8px;
  min-width: 0;
  max-width: none;
  padding: 10px 12px;
  border-radius: 16px;
  background: var(--card-soft);
  backdrop-filter: none;
}

.sidebar .views__label {
  font-size: 11px;
  letter-spacing: .8px;
  text-transform: uppercase;
}

/* Dos columnas: las 4 vistas caben en 2x2 sin desbordar los 19rem. */
.sidebar .views__group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.sidebar .chip {
  width: 100%;
  justify-content: center;
  padding: 8px 6px;
  font-size: 12px;
  min-height: 36px;
  text-align: center;
}

.sidebar .settings {
  grid-template-columns: 1fr auto;
  align-items: center;
}

.sidebar .lang-select {
  width: 100%;
  min-width: 0;
}

/* ── Escritorio: panel fijo ─────────────────────────────────────── */

@media (min-width:1024px) {
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100dvh;
  }

  .drawer-btn,
  .drawer-overlay {
    display: none !important;
  }

  body.drawer-open {
    overflow: auto;
  }
}

/* ── Movil / tablet: drawer off-canvas ──────────────────────────── */

@media (max-width:1023.98px) {
  .sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(19rem, 86vw);
    height: 100dvh;
    transform: translateX(-100%);
    transition: transform .28s ease;
  }

  .sidebar.is-open {
    transform: none;
    box-shadow: 0 0 60px rgba(0, 0, 0, .5);
  }

  /* Deja aire para el boton flotante del drawer. */
  .shell__main {
    padding-top: 58px;
  }

  body.drawer-open {
    overflow: hidden;
  }
}

@media (prefers-reduced-motion:reduce) {
  .sidebar {
    transition: none;
  }
}

/* ── Boton y velo del drawer ────────────────────────────────────── */

.drawer-btn {
  display: inline-flex;
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 70;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: color-mix(in srgb, var(--bg) 84%, transparent);
  backdrop-filter: blur(12px);
  color: var(--text);
  font-size: 18px;
  cursor: pointer;
}

.drawer-overlay {
  position: fixed;
  inset: 0;
  z-index: 55;
  background: rgba(0, 0, 0, .55);
  backdrop-filter: blur(2px);
}

.drawer-overlay[hidden] {
  display: none;
}

/* ══════════════════════════════════════════════════════════════════
   HERO COMO TARJETA DE DOS COLUMNAS
   El titular queda solo en la columna izquierda y todo el material de
   apoyo (flujo IA, contexto, pills, CTAs, redes) se agrupa a la
   derecha. Las tarjetas de perfil pasan a una fila bajo el titular en
   vez de una columna estrecha a su lado.
   ══════════════════════════════════════════════════════════════════ */

.hero {
  padding: 34px 0 10px;
}

.shell .hero__inner {
  display: block;
  padding: 30px 30px 34px;
  border: 1px solid var(--line);
  border-radius: var(--radius-shell);
  background: linear-gradient(135deg, color-mix(in srgb, var(--text) 7%, var(--bg)), var(--bg));
  box-shadow: var(--shadow);
}

.hero__copy {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
  gap: 30px;
  align-items: start;
}

/* La columna del titular pasa de ~1100px a ~456px: con el clamp original
   (52px) el h1 en espanol ocupaba 286px de alto y descuadraba la tarjeta. */
.hero__lead h1 {
  margin: 0 0 16px;
  font-size: clamp(30px, 3.3vw, 44px);
  letter-spacing: -.4px;
}

.hero__support {
  display: grid;
  align-content: start;
  gap: 14px;
}

/* El gap del grid marca el ritmo: los margenes propios lo duplicaban. */
.hero__support>* {
  margin-top: 0;
  margin-bottom: 0;
}

.hero__support .hero__context,
.hero__support .lead {
  max-width: none;
}

.shell .hero__cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 16px;
  margin-top: 28px;
  padding-top: 26px;
  border-top: 1px solid var(--line);
}

@media (max-width:900px) {
  .hero__copy {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .shell .hero__inner {
    padding: 22px 18px 26px;
    border-radius: 20px;
  }
}

/* ══════════════════════════════════════════════════════════════════
   FOOTER CON REDES COMO ICONOS
   Antes las redes eran dos filas de enlaces de texto: una en el hero
   (GitHub/GitLab/LinkedIn/YouTube) y otra dentro de #contacto, oculta
   por debajo del nivel 1. Ahora hay una sola fila de iconos al cierre
   de la pagina, visible en las 4 vistas. Los SVG van en linea porque
   la CSP no admite hosts externos; heredan el color con currentColor.
   ══════════════════════════════════════════════════════════════════ */

.site-footer {
  margin-top: 44px;
  padding: 26px 0 44px;
  border-top: 1px solid var(--line);
}

.site-footer__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.site-footer__copy {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.social-icons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

/* 44x44 = objetivo tactil minimo recomendado; el icono va a 20px dentro. */
.social-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--btn-bg);
  color: var(--muted);
  transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease;
}

.social-icon svg {
  display: block;
  width: 20px;
  height: 20px;
  fill: currentColor;
}

.social-icon:hover,
.social-icon:focus-visible {
  color: var(--text);
  border-color: var(--line-strong);
  background: var(--surface);
  transform: translateY(-2px);
}

@media (prefers-reduced-motion:reduce) {
  .social-icon {
    transition: none;
  }

  .social-icon:hover,
  .social-icon:focus-visible {
    transform: none;
  }
}

@media (max-width:640px) {
  .site-footer__inner {
    justify-content: center;
    text-align: center;
  }
}

/* Sprite: solo aporta las definiciones <symbol>, nunca se pinta. */
.icon-sprite {
  display: none;
}

/* Copia del sidebar: 3 columnas x 2 filas. En una sola fila los 6 iconos
   pedirian 314px y el interior del sidebar mide 271px, asi que el sexto
   caia solo a una segunda linea. Se mantiene el objetivo tactil de 44px. */
.social-icons--side {
  display: grid;
  grid-template-columns: repeat(3, 44px);
  gap: 10px;
  margin-top: 2px;
  padding-left: 4px;
}

/* ── Centro de descargas: tarjeta "Modo inteligente" ────────────────
   El bloque de acciones pasaba de 44px (un skeleton) a 101px (dos
   botones envueltos en dos filas) al detectar la plataforma. Como
   .app-download centra en vertical, ese crecimiento empujaba el icono
   y el titulo ~28px hacia arriba: el salto que siempre se veia.
   Se reserva de antemano la altura del caso mas alto y los botones
   pasan a ancho completo, para que su numero de filas sea predecible
   en los 6 idiomas (el frances es el que mas alarga las etiquetas). */

#smartDownloadActions {
  min-height: 6.5rem;
  align-content: center;
}

#smartDownloadActions .btn,
#smartDownloadActions .skeleton-btn {
  flex: 1 1 100%;
  width: auto;
}
